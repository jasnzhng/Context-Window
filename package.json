{
  "name": "context-window",
  "version": "1.0.0",
  "description": "Context Window: a house whose narrator only remembers the room it just left",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "webpack --mode production && node --env-file-if-exists=.env server.js",
    "dev": "webpack --mode development --watch",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/plugin-transform-runtime": "^8.0.6",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/runtime": "^8.1.0",
    "@eslint/js": "^9.39.5",
    "babel-loader": "^10.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  }
